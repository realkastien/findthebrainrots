local PlayersMap: {[Player]: BufferSave} = {}

Players.PlayerRemoving:Connect(function(Player)
    PlayersMap[Player] = nil
end)

local function StepReplication()
    for Player, Send in PlayersMap do
        if Send.Cursor <= 0 then
            continue
        end

        local Buffer = buffer.create(Send.Cursor)
        buffer.copy(Buffer, 0, Send.Buffer, 0, Send.Cursor)
        Reliable:FireClient(Player, Buffer, Send.Instances)

        Send.Size = 64
        Send.Cursor = 0
        Send.Buffer = buffer.create(64)
        table.clear(Send.Instances)
    end
end
RunService.Heartbeat:Connect(StepReplication)
Reliable.OnServerEvent:Connect(function(Player: Player, Buffer: buffer, Instances: {Instance})
	RecieveCursor = 0
	RecieveBuffer = Buffer
	RecieveInstances = Instances
	RecieveInstanceCursor = 0
	local Size = buffer.len(RecieveBuffer)
	while (RecieveCursor < Size) do
		-- Read BLOCK: 1 bytes
		local BLOCK_START = Read(1)
		local Index = buffer.readu8(RecieveBuffer, BLOCK_START + 0)
		if Index == 9 then
			local Value: string = ReadEVENT_PlayerKillAttempt()
			if Events.Reliable[9] ~= nil then
				task.spawn(Events.Reliable[9], Player, Value)
			else
				if #Queue.Reliable[9] > 256 then
					warn("[Blink]: Event queue of \"PlayerKillAttempt\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[9], {Player, Value} :: {any})
			end
		elseif Index == 15 then
			local Value: string = ReadEVENT_TaskFinished()
			if Events.Reliable[15] ~= nil then
				task.spawn(Events.Reliable[15], Player, Value)
			else
				if #Queue.Reliable[15] > 256 then
					warn("[Blink]: Event queue of \"TaskFinished\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[15], {Player, Value} :: {any})
			end
		elseif Index == 21 then
			local Value: string = ReadEVENT_ChatMessage()
			if Events.Reliable[21] ~= nil then
				task.spawn(Events.Reliable[21], Player, Value)
			else
				if #Queue.Reliable[21] > 256 then
					warn("[Blink]: Event queue of \"ChatMessage\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[21], {Player, Value} :: {any})
			end
		elseif Index == 27 then
			local Value: string = ReadEVENT_PowerUpCollected()
			if Events.Reliable[27] ~= nil then
				task.spawn(Events.Reliable[27], Player, Value)
			else
				if #Queue.Reliable[27] > 256 then
					warn("[Blink]: Event queue of \"PowerUpCollected\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[27], {Player, Value} :: {any})
			end
		elseif Index == 28 then
			local Value: string = ReadEVENT_PowerUpUsed()
			if Events.Reliable[28] ~= nil then
				task.spawn(Events.Reliable[28], Player, Value)
			else
				if #Queue.Reliable[28] > 256 then
					warn("[Blink]: Event queue of \"PowerUpUsed\" exceeded 256, did you forget to implement a listener?")
				end
				table.insert(Queue.Reliable[28], {Player, Value} :: {any})
			end
		end
	end
end)
